{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/support",
      "destination": "/suporte/",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacidade/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
